# MegaInfomatix production settings (GoDaddy cPanel). Copy to deploy/production.env and fill in.
# deploy/production.env is git-ignored: it holds the database password and the JWT secret.
NODE_ENV=production
SERVE_CLIENT=true
TRUST_PROXY=true
CANONICAL_HOST=megainfomatix.com
CLIENT_URL=https://megainfomatix.com,https://www.megainfomatix.com

# cPanel > MySQL Databases
DATABASE_URL=mysql://FILL_IN_user:FILL_IN_password@localhost:3306/FILL_IN_database
DB_AUTO_MIGRATE=true

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=FILL_IN_secret
JWT_EXPIRES_IN=1d

# Python runs on demand (no background service on shared hosting)
PYTHON_BIN=/home/mjgykn3s9utp/megainfomatix/python/venv/bin/python
PYTHON_APP_DIR=python
PYTHON_SERVICE_TIMEOUT_MS=60000

# Python layer
PYTHON_ENV=production
LOG_LEVEL=INFO
MONITORING_INTERVAL_SECONDS=900
ANOMALY_ZSCORE_THRESHOLD=3.0
REPORTS_DIR=output/reports
