{
  "name": "megainfomatix-server",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "db:migrate": "knex migrate:latest --knexfile knexfile.js",
    "db:rollback": "knex migrate:rollback --knexfile knexfile.js",
    "db:make-migration": "knex migrate:make --knexfile knexfile.js -x js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.1.1",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "morgan": "^1.12.1",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1"
  },
  "description": "MegaInfomatix REST API (Node.js + Express)",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
