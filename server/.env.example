# ---- Server ----
# 5050 rather than 5000: macOS AirPlay Receiver occupies port 5000.
PORT=5050
NODE_ENV=development

# Allowed frontend origin(s) for CORS (comma-separated)
CLIENT_URL=http://localhost:3000

# ---- Database ----
# Shared with the Python layer. Engine is selected from the URL scheme:
#   sqlite:///data/megainfomatix.db            (default; path relative to project root)
#   postgresql://user:password@localhost:5432/megainfomatix
#   mysql://user:password@localhost:3306/megainfomatix   (npm install mysql2)
DATABASE_URL=sqlite:///data/megainfomatix.db
DB_SSL=false
# Run pending migrations on startup (defaults to true outside production)
DB_AUTO_MIGRATE=true

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_secure_secret
JWT_EXPIRES_IN=1d

# ---- Python analytics service ----
# Leave empty to disable /api/monitoring, /api/analysis, /api/reports (they return 503)
PYTHON_SERVICE_URL=http://localhost:8000
# ...or run Python on demand instead of a service (production/shared hosting):
# PYTHON_BIN=/path/to/python/venv/bin/python
PYTHON_SERVICE_TIMEOUT_MS=60000

# ---- Production (single domain) ----
# SERVE_CLIENT=true          # serve client/dist from this server
# TRUST_PROXY=true           # behind Apache/Passenger or another proxy
# CANONICAL_HOST=megainfomatix.com
