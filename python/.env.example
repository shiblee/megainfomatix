# ---- Environment ----
PYTHON_ENV=development
LOG_LEVEL=INFO

# ---- Database ----
# Same value as server/.env. Relative SQLite paths resolve from the project root.
#   sqlite:///data/megainfomatix.db
#   postgresql://user:password@localhost:5432/megainfomatix   (pip install "psycopg[binary]")
#   mysql://user:password@localhost:3306/megainfomatix        (pip install pymysql)
DATABASE_URL=sqlite:///data/megainfomatix.db

# ---- Monitoring ----
MONITORING_INTERVAL_SECONDS=60
# z-score above which a metric value is flagged as an anomaly
ANOMALY_ZSCORE_THRESHOLD=3.0

# ---- Reports ----
# Relative to the python/ directory
REPORTS_DIR=output/reports

# ---- Internal API (consumed by the Node.js server via PYTHON_SERVICE_URL) ----
PYTHON_SERVICE_HOST=127.0.0.1
PYTHON_SERVICE_PORT=8000
